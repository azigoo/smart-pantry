# Copia este archivo como ".env" en la raíz del proyecto y reemplaza los valores
# con los de tu propio proyecto de Firebase (ver docs/09-conexion-firebase.md).
#
# Todas las variables DEBEN empezar con EXPO_PUBLIC_ para que Expo las incluya
# en el cliente: https://docs.expo.dev/guides/environment-variables/
#
# Estas claves son públicas por diseño (identifican tu proyecto de Firebase, no
# son un secreto); la seguridad real la dan las Reglas de Seguridad de Firebase.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
